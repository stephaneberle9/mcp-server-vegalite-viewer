  "configurations": [
    {
      "name": "Debug Vega-Lite Viewer",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "mcp_server_vegalite_viewer",
